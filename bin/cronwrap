#!/usr/bin/env bash
# Run a job, preserve its result, and report an actionable check-in.
if [ "$#" -lt 3 ] || [ -z "$1" ] || [ -z "$2" ] || [ -z "$3" ]; then
    echo 'usage: cronwrap LOG_DIR SNITCH SCRIPT [ARGS...]' >&2
    exit 1
fi
logs_dir=$1
snitch=$2
script=$3
shift 3
mkdir -p "$logs_dir" || exit 1
logs_file="$logs_dir/$(basename "$script").log"
run_log=$(mktemp "$logs_dir/.cronwrap.XXXXXX") || exit 1
trap 'rm -f "$run_log"' EXIT
log() { printf '%s\n' "$*" | tee -a "$logs_file"; }
log "$(date)"
log "$script"
"$script" "$@" 2>&1 | tee -a "$logs_file" "$run_log"
codes=("${PIPESTATUS[@]}")
exit_code=${codes[0]}
if [ "${codes[1]}" -ne 0 ]; then
    log 'log write failed'
    [ "$exit_code" -eq 0 ] && exit_code=1
fi
log "exit: $exit_code"
log "completed at $(date)"
summary=$(sed -n 's/^backup-summary: //p' "$run_log" | tail -1)
[ -n "$summary" ] || summary="$(basename "$script"): exit=$exit_code"
# An overlapping attempt is not a fresh backup and must not overwrite its report.
if [ "$exit_code" -eq 75 ] && [[ "$summary" == SKIPPED:* ]]; then
    log 'not checking in: another backup is active'
    exit "$exit_code"
fi
# DMS Error Notices interpret s= on supported plans; m= adds the reason.
# Keep the established error reporting protocol rather than sending false success.
reported=false
for delay in 0 2 4; do
    [ "$delay" -eq 0 ] || sleep "$delay"
    if curl --fail --silent --show-error --connect-timeout 10 --max-time 20 \
        --data-urlencode "s=$exit_code" --data-urlencode "m=${summary:0:255}" \
        "https://nosnch.in/$snitch" >> "$logs_file" 2>&1; then
        reported=true
        break
    fi
    log 'check-in delivery failed'
done
if [ "$reported" = true ]; then
    log "reported at $(date)"
else
    log 'check-in delivery failed after retries'
    [ "$exit_code" -eq 0 ] && exit_code=1
fi
log ''
exit "$exit_code"
